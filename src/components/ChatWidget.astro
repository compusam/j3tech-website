---
// J3 TECH Agent - Chat Widget Component
const apiEndpoint = import.meta.env.PUBLIC_CHATBOT_API || 'https://j3tech-agent.compusam.workers.dev';
---

<div id="j3tech-chat-widget" data-api-endpoint={apiEndpoint}>
  <button id="chat-toggle-btn" class="chat-toggle-btn" aria-label="Abrir chat">
    <svg class="chat-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="chat-badge">AI</span>
  </button>

  <div id="chat-panel" class="chat-panel">
    <div class="chat-header">
      <div class="chat-header-content">
        <div class="chat-avatar">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
            <path d="M2 17l10 5 10-5"></path>
            <path d="M2 12l10 5 10-5"></path>
          </svg>
        </div>
        <div class="chat-header-text">
          <h3>J3 TECH Agent</h3>
          <span class="chat-status">
            <span class="status-dot"></span>
            En línea
          </span>
        </div>
      </div>
      <button id="chat-close-btn" class="chat-close-btn" aria-label="Cerrar chat">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div id="chat-messages" class="chat-messages">
      <div class="message bot-message">
        <div class="message-avatar">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
            <path d="M2 17l10 5 10-5"></path>
            <path d="M2 12l10 5 10-5"></path>
          </svg>
        </div>
        <div class="message-content">
          <div class="message-bubble">¡Hola! Soy el asistente virtual de J3 TECH. Puedo ayudarte con información sobre nuestros servicios de inteligencia empresarial, sostenibilidad y consultoría. ¿En qué puedo ayudarte hoy?</div>
          <span class="message-time">Ahora</span>
        </div>
      </div>
    </div>

    <div class="chat-suggestions">
      <button class="suggestion-btn" data-message="¿Qué servicios ofrece J3 TECH?">Servicios</button>
      <button class="suggestion-btn" data-message="¿Qué es YELMO?">YELMO®</button>
      <button class="suggestion-btn" data-message="¿Qué es el Sistema Neuro Sostenible?">Neuro Sostenible</button>
    </div>

    <form id="chat-form" class="chat-form">
      <input
        type="text"
        id="chat-input"
        class="chat-input"
        placeholder="Escribe tu mensaje..."
        autocomplete="off"
      />
      <button type="submit" class="chat-send-btn" aria-label="Enviar mensaje">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  #j3tech-chat-widget {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 9998;
    font-family: var(--font-body);
  }

  .chat-toggle-btn {
    position: relative;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent-purple));
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.4);
    transition: all 0.3s ease;
    color: white;
  }

  .chat-toggle-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 30px rgba(59, 130, 246, 0.5);
  }

  .chat-toggle-btn .chat-icon {
    transition: transform 0.3s ease;
  }

  .chat-toggle-btn.active .chat-icon {
    transform: rotate(90deg);
  }

  .chat-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    background: var(--color-accent-pink);
    color: white;
    font-size: 0.625rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 10px;
    letter-spacing: 0.05em;
  }

  .chat-panel {
    position: absolute;
    bottom: 80px;
    right: 0;
    width: 380px;
    max-height: 560px;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px) scale(0.95);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }

  .chat-panel.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.1));
    border-bottom: 1px solid var(--color-border);
  }

  .chat-header-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .chat-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent-purple));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .chat-header-text h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .chat-status {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    animation: pulse-status 2s ease infinite;
  }

  @keyframes pulse-status {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .chat-close-btn {
    background: transparent;
    border: none;
    color: var(--color-text-dim);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .chat-close-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-text);
  }

  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 320px;
  }

  .chat-messages::-webkit-scrollbar {
    width: 6px;
  }

  .chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }

  .chat-messages::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 3px;
  }

  .message {
    display: flex;
    gap: 0.75rem;
    animation: messageSlide 0.3s ease;
  }

  @keyframes messageSlide {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .message.user-message {
    flex-direction: row-reverse;
  }

  .message-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .bot-message .message-avatar {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent-purple));
    color: white;
  }

  .user-message .message-avatar {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-dim);
  }

  .message-content {
    max-width: 75%;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .message-content .message-bubble {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .bot-message .message-content .message-bubble {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    border-top-left-radius: 0.25rem;
  }

  .user-message .message-content .message-bubble {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent-purple));
    color: white;
    border-top-right-radius: 0.25rem;
  }

  /* Estilos para contenido markdown en respuestas del bot */
  .bot-message .message-bubble p {
    margin: 0 0 0.75rem 0;
  }

  .bot-message .message-bubble p:last-child {
    margin-bottom: 0;
  }

  .bot-message .message-bubble strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  .bot-message .message-bubble ul,
  .bot-message .message-bubble ol {
    margin: 0.5rem 0;
    padding-left: 1.25rem;
    list-style-position: outside;
  }

  .bot-message .message-bubble ul {
    list-style-type: disc;
  }

  .bot-message .message-bubble ol {
    list-style-type: decimal;
  }

  .bot-message .message-bubble li {
    margin: 0.375rem 0;
    line-height: 1.5;
    padding-left: 0.25rem;
  }

  .bot-message .message-bubble li::marker {
    color: var(--color-primary);
  }

  .bot-message .message-bubble a {
    color: var(--color-primary);
    text-decoration: underline;
    transition: opacity 0.2s;
  }

  .bot-message .message-bubble a:hover {
    opacity: 0.8;
  }

  .bot-message .message-bubble code {
    background: rgba(59, 130, 246, 0.15);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-family: 'Courier New', monospace;
    font-size: 0.8125rem;
    color: var(--color-primary);
  }

  .bot-message .message-bubble pre {
    background: rgba(0, 0, 0, 0.3);
    padding: 0.75rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 0.5rem 0;
    border: 1px solid var(--color-border);
  }

  .bot-message .message-bubble pre code {
    background: transparent;
    padding: 0;
    color: var(--color-text);
  }

  .bot-message .message-bubble em {
    font-style: italic;
    opacity: 0.9;
  }

  .message-time {
    font-size: 0.6875rem;
    color: var(--color-text-dim);
    opacity: 0.7;
  }

  .user-message .message-time {
    text-align: right;
  }

  .chat-suggestions {
    display: flex;
    gap: 0.5rem;
    padding: 0 1rem 0.75rem;
    flex-wrap: wrap;
  }

  .suggestion-btn {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    border-radius: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--font-body);
  }

  .suggestion-btn:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: var(--color-primary);
  }

  .chat-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem;
    border-top: 1px solid var(--color-border);
    background: rgba(30, 41, 59, 0.5);
  }

  .chat-input {
    flex: 1;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    padding: 0.75rem 1rem;
    color: var(--color-text);
    font-size: 0.875rem;
    font-family: var(--font-body);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .chat-input:focus {
    border-color: var(--color-primary);
  }

  .chat-input::placeholder {
    color: var(--color-text-dim);
  }

  .chat-send-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent-purple));
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .chat-send-btn:hover {
    transform: scale(1.05);
  }

  .chat-send-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .typing-indicator {
    display: flex;
    gap: 4px;
    padding: 0.75rem 1rem;
  }

  .typing-indicator span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-text-dim);
    animation: typing-bounce 1.4s ease infinite;
  }

  .typing-indicator span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .typing-indicator span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes typing-bounce {
    0%, 60%, 100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    30% {
      transform: translateY(-8px);
      opacity: 1;
    }
  }

  @media (max-width: 480px) {
    #j3tech-chat-widget {
      bottom: 1rem;
      right: 1rem;
    }

    .chat-panel {
      position: fixed;
      bottom: 0;
      right: 0;
      left: 0;
      width: 100%;
      max-height: 100vh;
      border-radius: 1rem 1rem 0 0;
    }

    .chat-toggle-btn {
      width: 54px;
      height: 54px;
    }
  }
</style>

<script is:inline>
  const API_ENDPOINT = document.getElementById('j3tech-chat-widget')?.dataset.apiEndpoint || 'https://j3tech-agent.compusam.workers.dev';
  
  document.addEventListener('astro:page-load', () => {
    const toggleBtn = document.getElementById('chat-toggle-btn');
    const closeBtn = document.getElementById('chat-close-btn');
    const chatPanel = document.getElementById('chat-panel');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');
    const chatMessages = document.getElementById('chat-messages');
    const suggestionBtns = document.querySelectorAll('.suggestion-btn');
    const sendBtn = document.querySelector('.chat-send-btn');

    let sessionId = localStorage.getItem('j3tech_session_id');
    if (!sessionId) {
      sessionId = 'session_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
      localStorage.setItem('j3tech_session_id', sessionId);
    }

    const toggleChat = () => {
      chatPanel?.classList.toggle('open');
      toggleBtn?.classList.toggle('active');
    };

    toggleBtn?.addEventListener('click', toggleChat);
    closeBtn?.addEventListener('click', toggleChat);

    const getCurrentTime = () => {
      return new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
    };

    const parseMarkdown = (text) => {
      if (!text) return '';
      
      // Escapar HTML para seguridad
      let html = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
      
      // Negritas: **texto**
      html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      
      // Itálicas: *texto*
      html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
      
      // Código inline: `código`
      html = html.replace(/`(.*?)`/g, '<code>$1</code>');
      
      // Enlaces: [texto](url)
      html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
      
      // Procesar líneas para listas y párrafos
      const lines = html.split('\n');
      const result = [];
      let inList = false;
      
      for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        const trimmed = line.trim();
        
        // Lista con guión: "- item" o "  - item"
        if (/^\s*-\s+/.test(line)) {
          if (!inList) {
            result.push('<ul>');
            inList = true;
          }
          const content = trimmed.replace(/^-\s+/, '');
          result.push(`<li>${content}</li>`);
        }
        // Lista numerada: "1. item" o "  1. item"
        else if (/^\s*\d+\.\s+/.test(line)) {
          if (!inList) {
            result.push('<ol>');
            inList = true;
          }
          const content = trimmed.replace(/^\d+\.\s+/, '');
          result.push(`<li>${content}</li>`);
        }
        // Línea vacía
        else if (trimmed === '') {
          if (inList) {
            result.push('</ul>');
            inList = false;
          }
        }
        // Texto normal - párrafo
        else {
          if (inList) {
            result.push('</ul>');
            inList = false;
          }
          result.push(`<p>${trimmed}</p>`);
        }
      }
      
      // Cerrar lista si quedó abierta
      if (inList) {
        result.push('</ul>');
      }
      
      return result.join('');
    };

    const addMessage = (content, isUser) => {
      const messageDiv = document.createElement('div');
      messageDiv.className = `message ${isUser ? 'user-message' : 'bot-message'}`;
      
      const avatarSvg = isUser 
        ? '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>'
        : '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>';

      const messageContent = isUser ? content : parseMarkdown(content);

      messageDiv.innerHTML = `
        <div class="message-avatar">${avatarSvg}</div>
        <div class="message-content">
          <div class="message-bubble">${messageContent}</div>
          <span class="message-time">${getCurrentTime()}</span>
        </div>
      `;
      
      chatMessages?.appendChild(messageDiv);
      if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
    };

    const showTypingIndicator = () => {
      const typingDiv = document.createElement('div');
      typingDiv.className = 'message bot-message typing-message';
      typingDiv.id = 'typing-indicator';
      typingDiv.innerHTML = `
        <div class="message-avatar">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
        </div>
        <div class="message-content">
          <div class="typing-indicator">
            <span></span><span></span><span></span>
          </div>
        </div>
      `;
      chatMessages?.appendChild(typingDiv);
      if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
    };

    const removeTypingIndicator = () => {
      document.getElementById('typing-indicator')?.remove();
    };

    const sendMessage = async (message) => {
      if (!message.trim()) return;

      addMessage(message, true);
      if (chatInput) chatInput.value = '';
      if (sendBtn) sendBtn.disabled = true;
      showTypingIndicator();

      try {
        const response = await fetch(API_ENDPOINT + '/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: message,
            sessionId: sessionId,
            pageUrl: window.location.href
          })
        });

        removeTypingIndicator();

        if (!response.ok) {
          throw new Error('Error en la respuesta');
        }

        const data = await response.json();
        addMessage(data.response || 'Entiendo tu interés. ¿Podrías especificar un poco más sobre lo que necesitas? Por ejemplo, sobre inteligencia de mercados, sostenibilidad o consultoría.', false);
      } catch (error) {
        removeTypingIndicator();
        addMessage('Entiendo tu interés. Podría ayudarte mejor con información sobre nuestros servicios principales: inteligencia de mercados, sostenibilidad o consultoría. ¿Te gustaría conocer más sobre alguna de estas áreas?', false);
        console.error('Chat error:', error);
      } finally {
        if (sendBtn) sendBtn.disabled = false;
        if (chatInput) chatInput.focus();
      }
    };

    chatForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (chatInput) sendMessage(chatInput.value);
    });

    suggestionBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const message = btn.getAttribute('data-message');
        if (message) sendMessage(message);
      });
    });

    chatInput?.addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        if (chatInput) sendMessage(chatInput.value);
      }
    });
  });
</script>
