---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://j3tech.mx';
const allBlogPosts = await getCollection('blog');
const recentPosts = allBlogPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'J3 TECH',
  'url': siteUrl,
  'description': 'Ecosistema de inteligencia empresarial que impulsa la transformación de organizaciones mediante inteligencia estratégica, sostenibilidad e innovación.',
  'logo': `${siteUrl}/images/j3tech/logo-j3.jpg`,
  'founder': {
    '@type': 'Person',
    'name': 'Julia López',
    'jobTitle': 'Fundadora y CEO de J3 TECH',
  },
  'areaServed': 'México',
  'knowsAbout': [
    'Inteligencia de Mercados',
    'Sostenibilidad Empresarial',
    'ESG',
    'Economía Circular',
    'Consultoría Estratégica',
    'IA Aplicada',
    'Cadenas de Suministro',
    'Geopolítica',
    'T-MEC',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'J3 TECH',
  'url': siteUrl,
  'description': 'Ecosistema de inteligencia empresarial que impulsa la transformación de organizaciones mediante inteligencia estratégica, sostenibilidad e innovación.',
  'inLanguage': 'es-MX',
  'publisher': {
    '@type': 'Organization',
    'name': 'J3 TECH',
  },
};

const services = [
  {
    icon: 'globe',
    title: 'YELMO®',
    subtitle: 'Inteligencia de Mercados',
    description: 'Analizamos mercados, competencia y consumidores para identificar oportunidades de crecimiento y anticipar riesgos estratégicos.'
  },
  {
    icon: 'shield',
    title: 'Sistema Neuro Sostenible®',
    subtitle: 'Sostenibilidad como Competitividad',
    description: 'ESG, ODS, economía circular y estrategias de financiamiento verde para transformar su organización.'
  },
  {
    icon: 'zap',
    title: 'J3 TECH',
    subtitle: 'Implementación Estratégica',
    description: 'Consultoría, capacitación, implementación tecnológica y gestión de proyectos para convertir estrategias en resultados.'
  }
];
---

<BaseLayout
  title="J3 TECH — Inteligencia Estratégica & Sostenibilidad"
  description="Ecosistema de inteligencia empresarial que impulsa la transformación de organizaciones mediante inteligencia estratégica, sostenibilidad e innovación. YELMO® y Sistema Neuro Sostenible®."
  schemas={[organizationSchema, websiteSchema]}
>
  <Navigation />
  <Hero />

  <main>
  <section class="services-preview">
    <div class="container">
      <h2 class="section-title">Nuestras Soluciones</h2>
      <p class="section-subtitle">Un ecosistema de inteligencia empresarial para impulsar su organización</p>
      <div class="services-grid">
        {services.map((service) => (
          <div class="service-card">
            <div class="brand-logo">
              <img src={`${base}images/j3tech/${service.title === 'YELMO®' ? 'logo-yelmo.png' : service.title === 'Sistema Neuro Sostenible®' ? 'logo-sns.png' : 'logo-j3.jpg'}`} alt={service.title} loading="lazy" />
            </div>
            <h3>{service.title}</h3>
            <p class="service-subtitle">{service.subtitle}</p>
            <p class="service-description">{service.description}</p>
          </div>
        ))}
      </div>
      <div class="view-all">
        <a href={`${base}servicios/`} class="btn btn-secondary">
          Ver Todos los Servicios
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="recent-posts">
    <div class="container">
      <h2 class="section-title">Centro de Inteligencia</h2>
      <p class="section-subtitle">Publicaciones, artículos y actividades</p>
      <div class="posts-grid">
        {recentPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            tags={post.data.tags}
          />
        ))}
      </div>
      <div class="view-all">
        <a href={`${base}blog/`} class="btn btn-secondary">
          Explorar Centro de Inteligencia
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
  </main>
</BaseLayout>

<style>
  .services-preview {
    padding: 6rem 2rem;
    position: relative;
  }

  .recent-posts {
    padding: 6rem 2rem 8rem;
    position: relative;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-dim);
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .service-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
    transition: all 0.2s ease;
  }

  .service-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.1);
    transform: translateY(-4px);
  }

  .brand-logo {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }

  .brand-logo img {
    max-height: 100%;
    max-width: 140px;
    width: auto;
    object-fit: contain;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 0.75rem;
    padding: 0.4rem 0.75rem;
  }

  .service-card h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .service-subtitle {
    color: var(--color-primary);
    font-weight: 500;
    font-size: 0.9375rem;
    margin-bottom: 1rem !important;
  }

  .service-description {
    color: var(--color-text-dim);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .view-all {
    text-align: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    font-family: var(--font-body);
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: rgba(59, 130, 246, 0.1);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .btn-secondary svg {
    transition: transform 0.2s ease;
  }

  .btn-secondary:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .services-preview,
    .recent-posts {
      padding: 4rem 1.5rem;
    }

    .services-grid,
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
