---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ChatWidget from '../components/ChatWidget.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schemas?: Array<Record<string, any>>;
  articleMeta?: {
    publishedTime: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
}

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://j3tech.mx';

const defaultTitle = 'J3 TECH — Inteligencia Estratégica & Sostenibilidad';
const defaultDesc = 'Ecosistema de inteligencia empresarial que impulsa la transformación de organizaciones mediante inteligencia estratégica, sostenibilidad e innovación. YELMO® y Sistema Neuro Sostenible®.';

const {
  title = defaultTitle,
  description = defaultDesc,
  image = '/images/j3tech/hero-bg.webp',
  type = 'website',
  noindex = false,
  schemas = [],
  articleMeta,
} = Astro.props;

const canonical = Astro.url.href;
const ogImage = image.startsWith('http') ? image : new URL(image, siteUrl).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content="J3 TECH" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        {articleMeta.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
        {articleMeta.author && <meta property="article:author" content={articleMeta.author} />}
        {articleMeta.section && <meta property="article:section" content={articleMeta.section} />}
        {articleMeta.tags?.map(tag => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <slot name="head" />

    {schemas.map(schema => <JsonLd data={schema} />)}

    <ClientRouter />
  </head>
  <body>
    <div class="cursor-follower"></div>
    <div class="site-background" aria-hidden="true"></div>
    <div id="page-content">
      <slot />
    </div>
    <ChatWidget />

    <style>
      .site-background {
        position: fixed;
        inset: 0;
        z-index: -2;
        background-image:
          linear-gradient(rgba(2, 6, 23, 0.55), rgba(15, 23, 42, 0.55)),
          url('/images/j3tech/hero-bg.webp');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        pointer-events: none;
      }

      #page-content {
        position: relative;
        z-index: 1;
      }

      .cursor-follower {
        width: 20px;
        height: 20px;
        border: 2px solid var(--color-accent-purple);
        border-radius: 50%;
        position: fixed;
        pointer-events: none;
        z-index: 9999;
        transition: all 0.1s ease;
        transform: translate(-50%, -50%);
        mix-blend-mode: difference;
      }

      .cursor-follower::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 4px;
        height: 4px;
        background: var(--color-accent-pink);
        border-radius: 50%;
      }
    </style>

    <script>
      if (!(window as any).__cursorFollowerInitialized) {
        (window as any).__cursorFollowerInitialized = true;
        document.addEventListener('mousemove', (e) => {
          const cursor = document.querySelector('.cursor-follower') as HTMLElement | null;
          if (!cursor) return;
          cursor.style.left = e.clientX + 'px';
          cursor.style.top = e.clientY + 'px';
        });
      }

      const bindInteractiveHover = () => {
        const cursor = document.querySelector('.cursor-follower') as HTMLElement | null;
        if (!cursor) return;
        const interactiveElements = document.querySelectorAll('a, button');
        interactiveElements.forEach((el) => {
          if ((el as any).__cursorHoverBound) return;
          (el as any).__cursorHoverBound = true;
          el.addEventListener('mouseenter', () => {
            cursor.style.width = '40px';
            cursor.style.height = '40px';
            cursor.style.backgroundColor = 'rgba(168, 85, 247, 0.2)';
          });
          el.addEventListener('mouseleave', () => {
            cursor.style.width = '20px';
            cursor.style.height = '20px';
            cursor.style.backgroundColor = 'transparent';
          });
        });
      };

      bindInteractiveHover();
      if (!(window as any).__cursorHoverListenerRegistered) {
        (window as any).__cursorHoverListenerRegistered = true;
        document.addEventListener('astro:page-load', bindInteractiveHover);
      }
    </script>
  </body>
</html>
